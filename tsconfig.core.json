{
  "//": "Layer 1: pure core and repo scripts, checked without the claude CLI. Hooks (*.tsx) are checked by `claude plugin validate --strict`.",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "resolveJsonModule": true
  },
  "include": [
    "scripts/**/*.mjs",
    "plugins/model-meter/hooks/core/**/*.ts",
    "scripts/fixtures/*.json",
    "security/*.json"
  ]
}
