{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm ci *)",
      "Bash(npm test *)",
      "Bash(node --test *)",
      "Bash(npx tsc *)",
      "Bash(claude plugin validate *)",
      "Bash(claude plugin test *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git fetch *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push origin main *)",
      "Bash(git push origin HEAD:main *)",
      "Bash(git push --tags *)",
      "Bash(git push --follow-tags *)",
      "Bash(git push origin v*)",
      "Bash(git push origin refs/tags/*)",
      "Bash(gh release *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr review --approve *)",
      "Bash(gh repo edit *)",
      "Bash(gh secret *)",
      "Bash(gh auth token *)",
      "Bash(curl * | sh *)",
      "Bash(curl * | bash *)",
      "Bash(wget * | sh *)",
      "Bash(rm -rf / *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)"
    ]
  }
}
